@page
@model OperationsModel
@using WebApp.Models
@{
    ViewData["Title"] = "Operational Tasks Portal";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">Operational Tasks Portal</h1>
            <p class="lead">Manage and track operational tasks for CSW implementation</p>
        </div>
    </div>

    <!-- Statistics Dashboard -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Tasks</h5>
                    <p class="display-4">@Model.TotalTasks</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Completed</h5>
                    <p class="display-4">@Model.CompletedTasks</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h5 class="card-title">In Progress</h5>
                    <p class="display-4">@Model.InProgressTasks</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Pending</h5>
                    <p class="display-4">@Model.PendingTasks</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tasks Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>All Operational Tasks</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Assigned To</th>
                                    <th>Due Date</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in Model.Tasks)
                                {
                                    <tr>
                                        <td>@task.Id</td>
                                        <td>
                                            <strong>@task.Title</strong>
                                            <br />
                                            <small class="text-muted">@task.Description</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@task.Category</span>
                                        </td>
                                        <td>
                                            @switch (task.Priority)
                                            {
                                                case TaskPriority.Critical:
                                                    <span class="badge bg-danger">Critical</span>
                                                    break;
                                                case TaskPriority.High:
                                                    <span class="badge bg-warning">High</span>
                                                    break;
                                                case TaskPriority.Medium:
                                                    <span class="badge bg-info">Medium</span>
                                                    break;
                                                case TaskPriority.Low:
                                                    <span class="badge bg-secondary">Low</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @switch (task.Status)
                                            {
                                                case OperationalTaskStatus.Completed:
                                                    <span class="badge bg-success">Completed</span>
                                                    break;
                                                case OperationalTaskStatus.InProgress:
                                                    <span class="badge bg-primary">In Progress</span>
                                                    break;
                                                case OperationalTaskStatus.Pending:
                                                    <span class="badge bg-warning">Pending</span>
                                                    break;
                                                case OperationalTaskStatus.Blocked:
                                                    <span class="badge bg-danger">Blocked</span>
                                                    break;
                                                case OperationalTaskStatus.Cancelled:
                                                    <span class="badge bg-dark">Cancelled</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@task.AssignedTo</td>
                                        <td>
                                            @if (task.DueDate.HasValue)
                                            {
                                                <span class="@(task.DueDate.Value < DateTime.Now && task.Status != OperationalTaskStatus.Completed ? "text-danger" : "")">
                                                    @task.DueDate.Value.ToString("MMM dd, yyyy")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@task.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Highlights -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h3>Portal Features</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <h5>✓ Task Management</h5>
                            <ul>
                                <li>Create and assign tasks</li>
                                <li>Track task status</li>
                                <li>Priority levels</li>
                                <li>Due date tracking</li>
                            </ul>
                        </div>
                        <div class="col-md-4">
                            <h5>✓ Dashboard & Analytics</h5>
                            <ul>
                                <li>Real-time statistics</li>
                                <li>Task categorization</li>
                                <li>Status visualization</li>
                                <li>Performance metrics</li>
                            </ul>
                        </div>
                        <div class="col-md-4">
                            <h5>✓ Integration Ready</h5>
                            <ul>
                                <li>Azure infrastructure</li>
                                <li>Scalable architecture</li>
                                <li>API extensibility</li>
                                <li>Security compliance</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
        margin-bottom: 1rem;
    }
    
    .card-body .display-4 {
        font-size: 2.5rem;
        font-weight: 300;
        margin: 0;
    }
    
    .table td {
        vertical-align: middle;
    }
    
    .badge {
        font-size: 0.8rem;
        padding: 0.35em 0.65em;
    }
</style>
